.DS_Store
*.wav
# Ubiquiti firmware binaries, used only to read message names. Copy from /bin on the doorbell.
examples/*/backups/ubnt_*
# Backups hold Ubiquiti assets and SSH key lines; keep them local.
examples/*/backups/*
!examples/*/backups/README.md
# Payloads from failed attempts; they hold device settings.
examples/*/notes/
# Files copied off a doorbell for study (see tools/copy-files.sh).
doorbell-files/
